<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HospitalManagementSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagementSystem.styles.css" asp-append-version="true" />
    <!--FlatPickr-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <!--alert-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!--Background-->
    <style>
        body {
            background-image: url('/Images/Background.png');
                background-repeat: no-repeat;
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                background-color: #2c3e50;
                margin: 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="container-fluid">
                    <a class="navbar-brand" href="/home">
                        <img src="~/Images/Icons/hospital.png" alt="Logo" width="30" height="24" class="d-inline-block align-text-top">
                        HospitalSystem
                    </a>
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="/Home/Doctors"><button class="btn btn-primary me-md-2" type="button">Make Appointment</button></a>
                    <a href="/Home/ShowApp"><button class="btn btn-primary" type="button">View Appiontments</button></a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container d-flex justify-content-center align-items-center position-relative">
        <main role="main" class="pb-3 d-flex justify-content-center align-items-center">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        <div class="container">
            &copy; 2026 - HospitalManagementSystem - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
